#define DEFAULT 0
#define GAME    1
#define NUM     2
#define SYM     3
#define FUN     4
#define ARROW   5
#define MOUSE   6
#define SCROLL  7
#define SNIPE   8
#define MOUSEMOVE 9

// Override max mouse cursor speed for &mmv (default 600 — tuned for 4K).
// On Retina Macs this feels slow; 1500 ≈ 2.5x. Drop back to 600 if too fast,
// bump toward 2000+ if still sluggish. Must precede <dt-bindings/zmk/pointing.h>.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500

// Same idea for &msc scroll speed (default 10). Higher = more lines per tick.
// 20 is urob/zmk-config's tested value; combined with the
// CONFIG_ZMK_POINTING_SMOOTH_SCROLLING flag in keyball39_right.conf this
// produces smooth, fast scrolling on macOS.
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

// Default &mt — used for the gui/alt/ctrl home row mods (A S D / K L ').
// Kept conservative: 150ms term + 150ms require-prior-idle. These mods are
// rarely needed mid-typing, so we prioritize safety against typing rolls
// over snappy activation.
&mt {
    tapping-term-ms = <150>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <150>;
};

&msc {
    // Was 0/400 — felt steppy because constant-speed scrolling has no warm-up
    // and the OS just rendered each event as one line. Now using a gentle
    // quadratic ramp; combined with CONFIG_ZMK_POINTING_SMOOTH_SCROLLING in
    // keyball39_right.conf, scroll events become high-resolution and macOS
    // smooths across pixels.
    acceleration-exponent = <1>;  // quadratic — gentle start, faster end
    time-to-max-speed-ms = <300>; // moderate ramp; lower=snappier, higher=more precision
    delay-ms = <0>;
};

// Keyboard-driven mouse cursor (&mmv MOVE_* on the MOUSE layer).
// Defaults from urob/zmk-config — gentle ramp for fine control.
// Knobs:
//   acceleration-exponent: 0=constant speed, 1=quadratic (smooth), higher=more aggressive
//   time-to-max-speed-ms:  higher = more precision on short taps, lower = snappier traversal
//   delay-ms:              dead time before motion starts (keep 0)
// Max speed itself is set by ZMK_POINTING_DEFAULT_MOVE_VAL (default 600);
// override with `#define ZMK_POINTING_DEFAULT_MOVE_VAL <n>` before pointing.h
// if you find max traversal too slow/fast for your display resolution.
&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph

    combos {
        compatible = "zmk,combos";

        // Toggle the MOUSEMOVE layer with a one-handed two-finger chord.
        // Tightened from the original 30/200: timeout-ms 15 means both keys
        // must hit within a single human-perceivable instant (typing rolls
        // have ≥30ms gaps), and require-prior-idle-ms 250 means there must
        // be a real pause from typing before the combo fires.
        combo_left_mousemove {
            timeout-ms = <15>;
            require-prior-idle-ms = <250>;
            key-positions = <2 3>;   // E + R
            bindings = <&tog MOUSEMOVE>;
        };
        combo_right_mousemove {
            timeout-ms = <15>;
            require-prior-idle-ms = <250>;
            key-positions = <6 7>;   // U + I
            bindings = <&tog MOUSEMOVE>;
        };
    };

    behaviors {
        // Home row mods for SHIFT — split into left/right so we can use
        // hold-trigger-key-positions to restrict which keys can trigger the
        // mod. SHIFT only fires when followed by an OPPOSITE-hand key.
        //   F (left, pos 13) + any right-hand key → LSHFT
        //   J (right, pos 16) + any left-hand key → LSHFT
        // Same-hand sequences (typing rolls like "off", "jk", "fred") never
        // fire shift — they just type normally.
        //
        // `balanced` flavor means the decision is based on release order, not
        // a tapping-term wait. Capitals feel instant: press F, press h,
        // release h, release F → LSHFT+h.
        hm_shift_l: hm_shift_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 35 36 37 38>;
            bindings = <&kp>, <&kp>;
        };
        hm_shift_r: hm_shift_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp Q       &kp W       &kp E        &kp R        &kp T                                    &kp Y          &kp U          &kp I        &kp O       &kp P
&mt LGUI A  &mt LALT S  &mt LCTRL D  &hm_shift_l LSHFT F  &kp G                            &kp H          &hm_shift_r LSHFT J  &mt LCTRL K  &mt LALT L  &mt LGUI APOS
&lt MOUSE Z &kp X       &kp C        &kp V        &kp B                                    &kp N          &kp M          &kp COMMA    &kp DOT     &lt MOUSE SLASH
&kp GLOBE   &none       &none        &kp ESC      &lt ARROW BACKSPACE  &lt FUN TAB         &lt SYM ENTER  &lt NUM SPACE                           &to GAME
            >;
        };

        game_layer {
            label = "GAME";
            bindings = <
&kp Q         &kp W     &kp E        &kp R        &kp T                                    &kp Y          &kp U          &kp I        &kp O       &kp P
&mt LGUI A    &kp S     &kp D        &kp F        &kp G                                    &kp H          &hm_shift_r LSHFT J  &kp K        &mt LALT L  &kp APOS
&lt MOUSE Z   &kp X     &kp C        &kp V        &kp B                                    &kp N          &kp M          &kp COMMA    &kp DOT     &lt MOUSE SLASH
&kp LCTRL     &kp LALT  &kp LSHFT    &kp ESC      &lt ARROW BACKSPACE  &lt FUN TAB         &lt SYM ENTER  &lt NUM SPACE                           &to DEFAULT
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET                    &none   &none      &none      &none     &none
&kp SEMI          &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL                            &none   &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH                        &none   &none      &none      &none     &none
&none             &none         &none         &kp PERIOD    &kp NUMBER_0   &kp MINUS             &none  &trans                           &none
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp LS(LEFT_BRACKET)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(RIGHT_BRACKET)                         &none  &none      &none      &none     &none
&kp LS(SEMI)          &kp LS(NUMBER_4)  &kp LS(NUMBER_5)  &kp LS(NUMBER_6)  &kp LS(EQUAL)                                 &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&kp LS(GRAVE)         &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(BACKSLASH)                             &none  &none      &none      &none     &none
&none                 &none             &none             &kp LS(NUMBER_9)  &kp LS(NUMBER_0)       &kp LS(MINUS)          &trans &none                           &none
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&none     &none     &none      &none      &none                 &kp PRINTSCREEN  &kp F7  &kp F8  &kp F9  &kp F12
&kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none                 &kp SCROLLLOCK   &kp F4  &kp F5  &kp F6  &kp F11
&none     &none     &none      &none      &none                 &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F10
&none     &none     &none      &none      &trans  &trans        &trans           &trans                  &none
            >;
        };

        arrow_layer {
            label = "ARROW";
            bindings = <
&trans    &trans               &trans     &trans              &bt BT_CLR             &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp LGUI  &kp LALT             &kp LCTRL  &kp LSHFT           &trans                 &kp CAPS      &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT
&trans    &kp K_VOLUME_DOWN    &kp K_MUTE &kp K_VOLUME_UP     &kp LC(LS(LA(LG(M))))  &kp INS       &kp HOME      &kp PG_DN     &kp PG_UP     &kp END
&trans    &trans               &trans     &trans              &trans  &trans         &trans  &trans                                          &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none   &none   &none   &none      &none                            &none      &none     &none          &none        &kp DEL
&trans  &trans  &trans  &trans     &none                            &kp CAPS   &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT
&trans  &lt SCROLL X  &none   &none      &none                            &kp INS    &kp HOME  &kp PAGE_DOWN  &lt SCROLL PAGE_UP  &trans
&none   &none   &none   &mkp RCLK  &mkp LCLK  &mkp MCLK             &mkp RCLK  &mkp LCLK                             &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans    &trans  &trans  &sys_reset  &bootloader          &bootloader   &sys_reset  &trans  &trans  &trans
&trans    &trans  &trans  &trans     &trans               &trans        &trans     &trans  &trans  &trans
&trans    &trans  &trans  &trans     &trans               &trans        &trans     &trans  &trans  &trans
&trans    &trans  &trans  &trans     &trans      &trans   &trans        &trans                     &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans &trans                &trans  &trans                  &trans
            >;
        };

        // Two-handed keyboard mouse layer. Entered/exited via combos:
        //   left hand:  E + R together (after 250ms idle, 15ms timeout)
        //   right hand: U + I together (same)
        // Inverted-T movement clusters on each hand:
        //   left:  E=up, S=left, D=down, F=right
        //   right: I=up, J=left, K=down, L=right
        // Scroll moved to the bottom row, finger-natural (middle=up, index=down):
        //   left:  C=scroll up,  V=scroll down
        //   right: ,=scroll up,  M=scroll down
        // Dedicated EXIT keys (alongside the combo): Z (left bottom-row pinky)
        // and / (right bottom-row pinky).
        // Page navigation: PAGE_UP on Q and P (top-row corners, either pinky),
        // PAGE_DOWN on A and ' (home-row corners, either pinky).
        // Clicks on the thumb cluster — no auto-exit, click and scroll freely.
        // Other positions are &trans (type normally, layer stays on).
        mousemove_layer {
            label = "MMOVE";
            bindings = <
&kp PAGE_UP     &trans         &mmv MOVE_UP    &trans            &trans                                  &trans         &trans         &mmv MOVE_UP   &trans         &kp PAGE_UP
&kp PAGE_DOWN   &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT   &trans                                  &trans         &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &kp PAGE_DOWN
&tog MOUSEMOVE  &trans         &msc SCRL_UP    &msc SCRL_DOWN    &trans                                  &trans         &msc SCRL_DOWN &msc SCRL_UP   &trans         &tog MOUSEMOVE
&trans          &trans         &trans          &mkp RCLK         &mkp LCLK        &mkp MCLK              &mkp RCLK      &mkp LCLK                                    &trans
            >;
        };
    };
};
