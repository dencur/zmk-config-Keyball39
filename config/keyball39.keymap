#define DEFAULT 0
#define GAME    1
#define NUM     2
#define SYM     3
#define FUN     4
#define ARROW   5
#define MOUSE   6
#define SCROLL  7
#define SNIPE   8
#define MOUSEMOVE 9

// Override max mouse cursor speed for &mmv (default 600 — tuned for 4K).
// On Retina Macs this feels slow; 1500 ≈ 2.5x. Drop back to 600 if too fast,
// bump toward 2000+ if still sluggish. Must precede <dt-bindings/zmk/pointing.h>.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500

// Same idea for &msc scroll speed (default 10). Higher = more lines per tick.
// 20 is urob/zmk-config's tested value; combined with the
// CONFIG_ZMK_POINTING_SMOOTH_SCROLLING flag in keyball39_right.conf this
// produces smooth, fast scrolling on macOS.
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

// Default &mt — used for the gui/alt/ctrl home row mods (A S D / K L ').
// Kept conservative: 150ms term + 150ms require-prior-idle. These mods are
// rarely needed mid-typing, so we prioritize safety against typing rolls
// over snappy activation.
&mt {
    tapping-term-ms = <150>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <150>;
};

&msc {
    // Was 0/400 — felt steppy because constant-speed scrolling has no warm-up
    // and the OS just rendered each event as one line. Now using a gentle
    // quadratic ramp; combined with CONFIG_ZMK_POINTING_SMOOTH_SCROLLING in
    // keyball39_right.conf, scroll events become high-resolution and macOS
    // smooths across pixels.
    acceleration-exponent = <1>;  // quadratic — gentle start, faster end
    time-to-max-speed-ms = <300>; // moderate ramp; lower=snappier, higher=more precision
    delay-ms = <0>;
};

// Keyboard-driven mouse cursor (&mmv MOVE_* on the MOUSE layer).
// Defaults from urob/zmk-config — gentle ramp for fine control.
// Knobs:
//   acceleration-exponent: 0=constant speed, 1=quadratic (smooth), higher=more aggressive
//   time-to-max-speed-ms:  higher = more precision on short taps, lower = snappier traversal
//   delay-ms:              dead time before motion starts (keep 0)
// Max speed itself is set by ZMK_POINTING_DEFAULT_MOVE_VAL (default 600);
// override with `#define ZMK_POINTING_DEFAULT_MOVE_VAL <n>` before pointing.h
// if you find max traversal too slow/fast for your display resolution.
&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph

    combos {
        compatible = "zmk,combos";

        // Toggle the MOUSEMOVE layer with a two-finger chord. Global
        // (no layers restriction) — same chord enters from QWRT and
        // exits from MMOVE. timeout-ms 25 means both keys must hit
        // within a quick window (typing rolls have ≥30ms gaps);
        // require-prior-idle-ms 250 means a real pause from typing
        // before it can fire.
        // Left hand: S + D. Right hand: K + L.
        // NOTE: on MMOVE, S and D are MOVE_LEFT / MOVE_DOWN. A deliberate
        // simultaneous S+D tap exits the layer; normal diagonal movement
        // (press S, then add D >25ms later, holding) does not.
        combo_sd_mmove {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <11 12>; // S + D
            bindings = <&tog MOUSEMOVE>;
        };
        combo_right_mousemove {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <17 18>; // K + L
            bindings = <&tog MOUSEMOVE>;
        };

        // Lock MOUSE on via one-handed two-finger chord (same model as
        // the MOUSEMOVE combos). Z and / are already &lt MOUSE — holding
        // momentarily activates MOUSE; the combo is the "stay there"
        // path. Click bindings on MOUSE call &tog MOUSE (via the
        // click_exit_* macros) so clicking exits the lock.
        combo_left_mouse {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <20 21>; // Z + X
            bindings = <&tog MOUSE>;
        };
        combo_right_mouse {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <28 29>; // . + /
            bindings = <&tog MOUSE>;
        };

        // Three-finger scroll combos, active on QWRT and MMOVE. Looser
        // 50ms window than the 2-key combos — a 3-key chord is harder
        // to land simultaneously, and rolling three specific keys
        // mid-typing is unlikely, so the wider window is safe.
        // require-prior-idle-ms 250 still blocks it during a typing
        // burst. Held: all three keys down keeps &msc scrolling;
        // release any one to stop. Both hands, mirrored:
        //   right: U+I+O up, M+,+. down
        //   left:  W+E+R up, X+C+V down
        // NOTE: X+C+V is a superset of the copy/paste/cut 2-key combos,
        // so those pick up ~50ms standalone activation latency (the
        // resolver waits out X+C+V's candidacy window). Accepted
        // tradeoff. W+E+R has no such overlap.
        combo_scroll_up {
            timeout-ms = <50>;
            require-prior-idle-ms = <250>;
            key-positions = <6 7 8>;     // U + I + O
            bindings = <&msc SCRL_UP>;
            layers = <DEFAULT MOUSEMOVE>;
        };
        combo_scroll_down {
            timeout-ms = <50>;
            require-prior-idle-ms = <250>;
            key-positions = <26 27 28>;  // M + , + .
            bindings = <&msc SCRL_DOWN>;
            layers = <DEFAULT MOUSEMOVE>;
        };
        combo_scroll_up_left {
            timeout-ms = <50>;
            require-prior-idle-ms = <250>;
            key-positions = <1 2 3>;     // W + E + R
            bindings = <&msc SCRL_UP>;
            layers = <DEFAULT MOUSEMOVE>;
        };
        combo_scroll_down_left {
            timeout-ms = <50>;
            require-prior-idle-ms = <250>;
            key-positions = <21 22 23>;  // X + C + V
            bindings = <&msc SCRL_DOWN>;
            layers = <DEFAULT MOUSEMOVE>;
        };

        // Two-key action combos. 25ms window (the standard 2-key combo
        // timing here) + require-prior-idle-ms 250 so they can't fire
        // mid-typing-burst.
        //   - ESC combos (Q+W, J+K): DEFAULT only.
        //   - Editing combos (D+F del, A+S select-all, X+C copy,
        //     C+V paste, X+V cut): DEFAULT + MOUSEMOVE, so they're
        //     reachable while in the mouse-move layer too.
        //
        // The J+K position gets a SECOND combo gated to MOUSEMOVE
        // (combo_exit_mmove_jk), which fires &tog MOUSEMOVE instead of
        // ESC — so on MMOVE that chord is an extra layer-exit route,
        // matching the ESC-position key. A combo has only one binding,
        // hence the per-layer split. Q+W is DEFAULT-only ESC now (its
        // MMOVE-exit variant was removed).
        combo_esc_qw {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <0 1>;       // Q + W
            bindings = <&kp ESC>;
            layers = <DEFAULT>;
        };
        combo_esc_jk {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <16 17>;     // J + K
            bindings = <&kp ESC>;
            layers = <DEFAULT>;
        };
        combo_exit_mmove_jk {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <16 17>;     // J + K (on MMOVE → exit layer)
            bindings = <&tog MOUSEMOVE>;
            layers = <MOUSEMOVE>;
        };
        combo_del_df {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <12 13>;     // D + F
            bindings = <&kp DEL>;
            layers = <DEFAULT MOUSEMOVE>;
        };
        // Select-all (Cmd+A) on A+S. Both A+S and S+D are subsets of
        // the A+S+D caps_word combo — the resolver still picks the
        // 2-key combo correctly when the 3rd key isn't pressed, but
        // with ~50ms latency (it waits out caps_word's candidacy
        // window). Acceptable: neither is speed-critical, and pressing
        // all of A+S+D fires caps_word cleanly.
        combo_select_all_as {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <10 11>;     // A + S
            bindings = <&kp LG(A)>;
            layers = <DEFAULT MOUSEMOVE>;
        };
        combo_copy_xc {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <21 22>;     // X + C
            bindings = <&kp LG(C)>;
            layers = <DEFAULT MOUSEMOVE>;
        };
        combo_paste_cv {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <22 23>;     // C + V
            bindings = <&kp LG(V)>;
            layers = <DEFAULT MOUSEMOVE>;
        };
        combo_cut_xv {
            timeout-ms = <25>;
            require-prior-idle-ms = <250>;
            key-positions = <21 23>;     // X + V
            bindings = <&kp LG(X)>;
            layers = <DEFAULT MOUSEMOVE>;
        };

        // Three-key caps-word combo. A+S+D — position 10 (A) is unique
        // to this combo, so there's no subset/superset ambiguity with
        // any other combo. 50ms window (the >2-key standard here).
        // Fires &caps_word: the next word is shifted, auto-ends on
        // space/most punctuation (continue-list keeps it through - and _).
        combo_caps_word {
            timeout-ms = <50>;
            require-prior-idle-ms = <250>;
            key-positions = <10 11 12>;  // A + S + D
            bindings = <&caps_word>;
            layers = <DEFAULT>;
        };
    };

    behaviors {
        // === Home row mods ===
        // Pattern from urob/zmk-config (state-of-the-art for ZMK 3.5+):
        //
        //   1. flavor = "balanced": hold vs tap is decided by RELEASE
        //      ORDER, not a timer. Typing roll (release first key first) →
        //      tap. Deliberate shortcut (release inner key first, then
        //      mod) → hold. Natural distinction.
        //
        //   2. hold-trigger-key-positions = <opposite-hand only>: the mod
        //      ONLY fires when the next key is on the opposite hand.
        //      Same-hand sequences ("knowledge" k+o, "off" o+f+f) can't
        //      fire mods at all — they always type as letters.
        //
        //   3. hold-trigger-on-release: defers the decision to when the
        //      second key is released, which combines cleanly with
        //      balanced flavor for clean per-keypress resolution.
        //
        //   4. require-prior-idle-ms (non-shift only): blocks hold
        //      detection if the mod key was pressed within Nms of any
        //      prior key. Belt-and-suspenders on top of the cross-hand
        //      protection.
        //
        // SHIFT (F, J) doesn't use require-prior-idle-ms because capitals
        // need to fire instantly mid-typing-burst. Cross-hand triggers +
        // balanced flavor are enough to keep it safe.
        // CTRL/ALT/GUI (A, S, D, K, L, ') use require-prior-idle-ms 150
        // since they're rarely needed mid-burst and the user reported
        // misfires (e.g. "knowledge" → Ctrl+O) before this was added.

        // Tuning for user typing 80 WPM static, ~130 WPM in bursts
        // (inter-key gap ~92 ms burst, ~150 ms static).
        //
        // - tapping-term-ms = 200: tighter window for the balanced-flavor
        //   release-order check. Combined with require-prior-idle-ms, this
        //   shrinks the time where an opposite-hand release inside the
        //   term can be misinterpreted as a completed hold.
        // - quick-tap-ms = 200: typing the same letter twice in <200 ms
        //   (e.g. "ll", "ss") forces tap-tap, not tap-then-hold.
        // - require-prior-idle-ms = 200: blocks hold firing if the prior
        //   key was pressed within 200 ms — fully covers 130 WPM bursts
        //   (92 ms gaps) and most 80 WPM static (150 ms gaps). Only
        //   deliberate mod use after a clear pause activates HRM.
        // SHIFT mods keep no require-prior-idle-ms (capitals must fire
        // mid-burst) but inherit the tighter term and longer quick-tap.

        // Non-shift home row mod, LEFT hand. Used for A (LGUI), S (LALT), D (LCTRL).
        hm_l: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 35 36 37 38>;
            bindings = <&kp>, <&kp>;
        };
        // Non-shift home row mod, RIGHT hand. Used for K (LCTRL), L (LALT), ' (LGUI).
        hm_r: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34>;
            bindings = <&kp>, <&kp>;
        };
        // SHIFT home row mods. Same pattern as hm_l/hm_r but no
        // require-prior-idle-ms — capitals need to fire instantly even
        // mid-typing-burst.
        hm_shift_l: hm_shift_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 35 36 37 38>;
            bindings = <&kp>, <&kp>;
        };
        hm_shift_r: hm_shift_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34>;
            bindings = <&kp>, <&kp>;
        };

        // GAME-layer entry guarded by double-tap. Position 38 was firing
        // accidentally from palm/pinky brushes — single tap now no-ops,
        // two taps within 250ms enter GAME. Exit (in game_layer) is still
        // single-tap so leaving the layer is friction-free.
        game_td: game_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&to GAME>;
        };
    };

    macros {
        // Click-and-exit-MOUSE macros.
        //
        // MOUSE is entered explicitly (hold Z/SLASH via &lt, or the
        // z+x / .+/ combos which &tog it on). These macros make clicks
        // terminal: send the click, hold it for the duration the key is
        // held (so drag works), and on release fire &tog MOUSE to drop
        // the layer. Combined with the combos, the model is "enter →
        // act → click exits."
        click_exit_l: click_exit_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mkp LCLK>
                , <&macro_pause_for_release>
                , <&macro_release &mkp LCLK>
                , <&tog MOUSE>
                ;
        };
        click_exit_r: click_exit_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mkp RCLK>
                , <&macro_pause_for_release>
                , <&macro_release &mkp RCLK>
                , <&tog MOUSE>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp Q       &kp W       &kp E        &kp R        &kp T                                    &kp Y          &kp U          &kp I        &kp O       &kp P
&hm_l LGUI A  &hm_l LALT S  &hm_l LCTRL D  &hm_shift_l LSHFT F  &kp G                        &kp H  &hm_shift_r LSHFT J  &hm_r LCTRL K  &hm_r LALT L  &hm_r LGUI APOS
&lt MOUSE Z &kp X       &kp C        &kp V        &kp B                                    &kp N          &kp M          &kp COMMA    &kp DOT     &lt MOUSE SLASH
&kp GLOBE   &none       &none        &kp ESC      &lt ARROW BACKSPACE  &lt FUN TAB         &lt SYM ENTER  &lt NUM SPACE                           &game_td
            >;
        };

        game_layer {
            label = "GAME";
            bindings = <
&kp Q         &kp W     &kp E        &kp R        &kp T                                    &kp Y          &kp U          &kp I        &kp O       &kp P
&hm_l LGUI A    &kp S     &kp D        &kp F        &kp G                                    &kp H          &hm_shift_r LSHFT J  &kp K        &hm_r LALT L  &kp APOS
&lt MOUSE Z   &kp X     &kp C        &kp V        &kp B                                    &kp N          &kp M          &kp COMMA    &kp DOT     &lt MOUSE SLASH
&kp LCTRL     &kp LALT  &kp LSHFT    &kp ESC      &lt ARROW BACKSPACE  &lt FUN TAB         &lt SYM ENTER  &lt NUM SPACE                           &to DEFAULT
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET                    &none   &none      &none      &none     &none
&kp SEMI          &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL                            &none   &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH                        &none   &none      &none      &none     &none
&none             &none         &none         &kp PERIOD    &kp NUMBER_0   &kp MINUS             &none  &trans                           &none
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp LS(LEFT_BRACKET)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(RIGHT_BRACKET)                         &none  &none      &none      &none     &none
&kp LS(SEMI)          &kp LS(NUMBER_4)  &kp LS(NUMBER_5)  &kp LS(NUMBER_6)  &kp LS(EQUAL)                                 &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&kp LS(GRAVE)         &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(BACKSLASH)                             &none  &none      &none      &none     &none
&none                 &none             &none             &kp LS(NUMBER_9)  &kp LS(NUMBER_0)       &kp LS(MINUS)          &trans &none                           &none
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&none     &none     &none      &none      &none                 &kp PRINTSCREEN  &kp F7  &kp F8  &kp F9  &kp F12
&kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none                 &kp SCROLLLOCK   &kp F4  &kp F5  &kp F6  &kp F11
&none     &none     &none      &none      &none                 &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F10
&none     &none     &none      &none      &trans  &trans        &trans           &trans                  &none
            >;
        };

        arrow_layer {
            label = "ARROW";
            bindings = <
&trans    &trans               &trans     &trans              &bt BT_CLR             &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp LGUI  &kp LALT             &kp LCTRL  &kp LSHFT           &trans                 &kp CAPS      &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT
&trans    &kp K_VOLUME_DOWN    &kp K_MUTE &kp K_VOLUME_UP     &kp LC(LS(LA(LG(M))))  &kp INS       &kp HOME      &kp PG_DN     &kp PG_UP     &kp END
&trans    &trans               &trans     &trans              &trans  &trans         &trans  &trans                                          &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none   &none   &none   &none      &none                            &kp INS    &kp HOME      &kp PAGE_DOWN  &none               &kp DEL
&trans  &trans  &trans  &trans     &none                            &kp CAPS   &kp LEFT      &kp DOWN       &kp UP              &kp RIGHT
&trans  &lt SCROLL X  &none   &none      &none                       &none      &msc SCRL_DOWN  &msc SCRL_UP  &lt SCROLL PAGE_UP  &trans
&none   &none   &none   &tog MOUSE     &click_exit_l  &click_exit_r     &click_exit_r  &click_exit_l                     &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans    &trans  &trans  &sys_reset  &bootloader          &bootloader   &sys_reset  &trans  &trans  &trans
&trans    &trans  &trans  &trans     &trans               &trans        &trans     &trans  &trans  &trans
&trans    &trans  &trans  &trans     &trans               &trans        &trans     &trans  &trans  &trans
&trans    &trans  &trans  &trans     &trans      &trans   &trans        &trans                     &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans &trans                &trans  &trans                  &trans
            >;
        };

        // Two-handed keyboard mouse layer. Entered/exited via combos:
        //   left hand:  S + D together (after 250ms idle, 25ms timeout)
        //   right hand: K + L together (same)
        //   also exits: J + K, or the ESC-position key
        // Inverted-T movement clusters on each hand:
        //   left:  E=up, S=left, D=down, F=right
        //   right: I=up, J=left, K=down, L=right
        // Vertical scroll (bottom row, finger-natural — middle=up, index=down):
        //   left:  C=scroll up,  V=scroll down
        //   right: M=scroll down, ,=scroll up
        // Horizontal scroll on the bottom-row pinky pairs:
        //   left:  Z=scroll left, X=scroll right
        //   right: .=scroll left, /=scroll right
        // macOS Accessibility Zoom (Cmd+Option+= / Cmd+Option+-):
        //   Q and P = zoom in, A and ' = zoom out.
        // Compositor-level magnifier — scales screen pixels, items roll
        // off the sides (closest keyboard equivalent to trackpad pinch).
        // ONE-TIME SETUP: System Settings → Accessibility → Zoom →
        // enable "Use keyboard shortcuts to zoom". Pick "Picture-in-
        // Picture" zoom style for the loupe-like feel.
        // Browser nav (Cmd+[ / Cmd+]) flanking the up-arrow on each hand:
        //   W = back, R = forward; U = back, O = forward.
        // EXIT: ESC position (left thumb on QWRT — muscle-memory) or
        // re-fire one of the entry combos. The previous Z and / exit
        // keys gave way to horizontal scroll.
        // Clicks on the thumb cluster — no auto-exit, click and scroll freely.
        // Other positions are &trans (type normally, layer stays on).
        mousemove_layer {
            label = "MMOVE";
            bindings = <
&kp LG(LA(EQUAL))   &kp LG(LBKT)        &mmv MOVE_UP    &kp LG(RBKT)      &trans                                  &trans         &kp LG(LBKT)   &mmv MOVE_UP   &kp LG(RBKT)        &kp LG(LA(EQUAL))
&kp LG(LA(MINUS))   &mmv MOVE_LEFT      &mmv MOVE_DOWN  &mmv MOVE_RIGHT   &trans                                  &trans         &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT     &kp LG(LA(MINUS))
&msc SCRL_LEFT      &msc SCRL_RIGHT     &msc SCRL_UP    &msc SCRL_DOWN    &trans                                  &trans         &msc SCRL_DOWN &msc SCRL_UP   &msc SCRL_LEFT      &msc SCRL_RIGHT
&trans              &trans              &trans          &tog MOUSEMOVE    &mkp LCLK        &mkp RCLK              &mkp RCLK      &mkp LCLK                                        &trans
            >;
        };
    };
};
